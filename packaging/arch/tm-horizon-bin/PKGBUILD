# Maintainer: cheatoskar
# Repacks the .deb of a TM Horizon release (built by .github/workflows/release.yml).
# The repository is private for now, so the download needs access; once it is public this
# works as is (then fill sha256sums with `updpkgsums`). Install: `makepkg -si` in this folder.
pkgname=tm-horizon-bin
_pkgname=tm-horizon
# pkgver cannot contain "-": the release tag v0.3.0-beta.1 becomes 0.3.0_beta.1 here.
_tag=0.5.1
pkgver=${_tag//-/_}
pkgrel=1
pkgdesc="One launcher for every TrackMania: games, TMLoader mods, maps, servers (games run through Wine/Proton)"
arch=('x86_64')
url="https://github.com/cheatoskar/tm-horizon"
license=('AGPL-3.0-only')
depends=('webkit2gtk-4.1' 'gtk3' 'librsvg' 'openssl' 'xdg-utils' 'hicolor-icon-theme')
optdepends=('wine: run the games in a Wine prefix'
            'umu-launcher: run the games with Proton outside Steam'
            'steam: Steam versions of the games (Proton)'
            'winetricks: fonts and runtimes for old games')
provides=('tm-horizon')
conflicts=('tm-horizon')
options=('!strip' '!debug')
source_x86_64=("$_pkgname-$pkgver.deb::$url/releases/download/v$_tag/TM-Horizon_${_tag}_amd64.deb")
sha256sums_x86_64=('SKIP')

package() {
  bsdtar -xf data.tar.gz -C "$srcdir"
  # Tauri names the binary after the Cargo package (tm-hub) and the icons the same way.
  install -Dm755 "$srcdir/usr/bin/tm-hub" "$pkgdir/usr/bin/tm-horizon"
  for size in 32x32 128x128 256x256@2; do
    local dest=${size%@2}
    [ -f "$srcdir/usr/share/icons/hicolor/$size/apps/tm-hub.png" ] &&
      install -Dm644 "$srcdir/usr/share/icons/hicolor/$size/apps/tm-hub.png" "$pkgdir/usr/share/icons/hicolor/$dest/apps/tm-horizon.png"
  done
  cat > "$srcdir/tm-horizon.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=TM Horizon
GenericName=TrackMania launcher
Comment=One launcher for every TrackMania
Exec=tm-horizon
Icon=tm-horizon
Terminal=false
Categories=Game;
StartupWMClass=tm-hub
DESKTOP
  install -Dm644 "$srcdir/tm-horizon.desktop" "$pkgdir/usr/share/applications/tm-horizon.desktop"
}

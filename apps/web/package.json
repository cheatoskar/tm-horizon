{
  "name": "@tm-hub/web",
  "private": true,
  "type": "module",
  "version": "0.5.1",
  "scripts": {
    "data": "node scripts/build-data.mjs && node scripts/build-github-projects.mjs",
    "dev": "npm run data && astro dev",
    "build": "npm run data && node ../../scripts/check-legal.mjs --summary && astro build",
    "build:public": "npm run data && node ../../scripts/check-legal.mjs --summary && node scripts/public-build.mjs",
    "check-legal": "node ../../scripts/check-legal.mjs",
    "preview": "astro preview",
    "check-i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@tm-hub/shared": "*",
    "@tm-hub/showcase-ui": "*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "astro": "^5.18.2",
    "lucide": "^0.468.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "license": "AGPL-3.0-only"
}

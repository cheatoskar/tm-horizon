---
// Project icon: the real one when there is one, otherwise a generated tile (gradient, speed stripes, category glyph).
import { icons } from 'lucide';
import { pair, seedNum } from '../lib/fmt';
import { webImg } from '@tm-hub/shared/extimg';
interface Props { src?: string | null; seed: string; glyph?: string; size?: number; class?: string; alt?: string; cover?: boolean }
const { src: raw, seed, glyph = 'puzzle', size = 96, class: cls = '', alt = '', cover = false } = Astro.props;
// Remote icons only through our image proxy (/ext-img/); otherwise the generated tile.
const src = raw?.startsWith('data:image/') ? raw : webImg(raw);
const [a, b] = pair(seed);
const n = seedNum(seed);
const angle = 20 + (n % 4) * 10;
const pascal = glyph.replace(/(^|-)([a-z0-9])/g, (_: string, __: string, c: string) => c.toUpperCase());
const node = (icons as any)[pascal] ?? (icons as any).Puzzle;
const inner = (node[2] as [string, Record<string, string>][]).map(([t, at]) => `<${t} ${Object.entries(at).map(([k, v]) => `${k}="${v}"`).join(' ')}/>`).join('');
const gid = 'g' + n.toString(36);
---
{src ? (
  <span class={`thumb ${cover ? 'cover' : ''} ${cls}`} style={`--s:${size}px`}><img src={src} alt={alt} loading="lazy" decoding="async" /></span>
) : (
  <span class={`thumb gen ${cls}`} style={`--s:${size}px`} aria-hidden="true">
    <svg viewBox="0 0 96 96" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color={a} /><stop offset="1" stop-color={b} /></linearGradient>
        <linearGradient id={gid + 's'} x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#fff" stop-opacity="0" /><stop offset="1" stop-color="#fff" stop-opacity=".22" /></linearGradient>
      </defs>
      <rect width="96" height="96" fill={`url(#${gid})`} />
      <g transform={`rotate(-${angle} 48 48)`} fill={`url(#${gid}s)`}>
        <rect x="-30" y="14" width="120" height="5" rx="2.5" /><rect x="-10" y="26" width="90" height="3" rx="1.5" /><rect x="10" y="70" width="110" height="4" rx="2" /><rect x="-20" y="80" width="70" height="2.5" rx="1.25" />
      </g>
      <circle cx="78" cy="16" r="26" fill="#fff" opacity=".08" />
      <g transform="translate(26 26) scale(1.8333)" fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" style="filter:drop-shadow(0 1.5px 1.5px rgba(0,0,0,.25))" set:html={inner} />
    </svg>
  </span>
)}

---
// "For developers" block on the home page: four cards into the developer docs (/dev/).
import Icon from './Icon.astro';
import { t, lh, type Lang } from '../i18n';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const cards = [
  { n: 1, icon: 'upload', href: '/dev/docs/tutorial-publish/' },
  { n: 2, icon: 'code', href: '/dev/docs/tutorial-first-script/' },
  { n: 3, icon: 'puzzle', href: '/dev/docs/tutorial-first-plugin/' },
  { n: 4, icon: 'shuffle', href: '/dev/docs/tutorial-crossover/' },
];
---
<section class="sec devblock">
  <div class="sec-h"><h2>{t(lang, 'home.dev.h')}</h2><span class="sub">{t(lang, 'home.dev.sub')}</span><a class="more" href={lh(lang, '/dev/')}>{t(lang, 'home.dev.all')} <Icon name="arrow-right" size={16} /></a></div>
  <div class="dev-cards">
    {cards.map((c) => (
      <a class="card dev-card" href={lh(lang, c.href)}>
        <span class="dev-ic"><Icon name={c.icon} size={22} /></span>
        <b>{t(lang, `home.dev.c${c.n}.h`)}</b>
        <span class="muted">{t(lang, `home.dev.c${c.n}.t`)}</span>
      </a>
    ))}
  </div>
</section>

<style>
  .dev-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; }
  .dev-card { display: grid; gap: 8px; align-content: start; padding: 20px; text-decoration: none; color: inherit; transition: transform .15s, box-shadow .15s; }
  .dev-card:hover { transform: translateY(-2px); box-shadow: var(--shadow), 0 0 0 1px var(--accent); }
  .dev-card b { font-size: 18px; }
  .dev-card .muted { font-size: 14.5px; line-height: 1.5; }
  .dev-ic { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: var(--surface-2); color: var(--accent); }
  @media (prefers-reduced-motion: reduce) { .dev-card { transition: none; } }
</style>

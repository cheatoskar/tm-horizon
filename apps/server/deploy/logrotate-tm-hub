# /etc/logrotate.d/tm-hub : nginx logs of the hub contain IP addresses and are kept 7 days (Datenschutzerklärung).
/var/log/nginx/tm-hub.*.log {
    daily
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        [ -s /run/nginx.pid ] && kill -USR1 $(cat /run/nginx.pid)
    endscript
}

# TM Horizon Hub server. Copy to .env for development; on the server use /etc/tm-hub/hub.env (mode 600).
# docs/hub/secrets.md lists which values are secret. Never commit a filled-in copy.

NODE_ENV=development
HOST=127.0.0.1
PORT=8787
HUB_PUBLIC_URL=http://localhost:5174/
HUB_PORTAL_URL=http://localhost:5174/

# sqlite:<file> for development, postgres://user:pass@127.0.0.1:5432/tmhub in production
DATABASE_URL=sqlite:./data/hub.sqlite

# fs (folder) or s3 (Oracle Object Storage, S3-compatible API)
STORAGE=fs
STORAGE_DIR=./data/files
# FILES_PUBLIC_URL=https://hub.example.org/files/
# S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
# S3_REGION=eu-frankfurt-1
# S3_BUCKET=tm-hub-files
# S3_ACCESS_KEY_ID=            (secret: Customer Secret Key, access part)
# S3_SECRET_ACCESS_KEY=        (secret)

# Index signing key: base64 Ed25519 seed from `npm run generate-key -w @tm-hub/server` (secret).
# Empty in development: a key is created in data/dev-index-key.txt and printed at start.
# HUB_INDEX_SIGNING_KEY=
# HUB_INDEX_PUBLIC_KEYS=
INDEX_EXPIRES_DAYS=7

# OAuth apps (secret parts marked). Callback URLs: <HUB_PUBLIC_URL>auth/discord/callback, <HUB_PUBLIC_URL>auth/github/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=       (secret)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=        (secret)

# Development only: log in as made-up accounts (admin, author, author2, user). Refused when NODE_ENV=production.
HUB_DEV_LOGIN=1
# Admins: discord:<user id>,github:<user id>
HUB_ADMINS=

# Crawler: GitHub token of the hub (fine-grained, public repositories, read-only; secret)
# GITHUB_TOKEN=
# GitHub App for instant release webhooks (optional)
# GITHUB_WEBHOOK_SECRET=       (secret)
# GITHUB_APP_SLUG=
CRAWLER=1
# Daily GitHub search for TrackMania projects nobody listed yet (docs/hub/discover-github.md); results wait in Admin > Discovered
DISCOVER_GITHUB=0
CRAWL_ACTIVE_MIN=20
CRAWL_QUIET_MIN=240

# Moderation channel webhook (secret: anyone with the URL can post)
# DISCORD_WEBHOOK_URL=
# VirusTotal (secret)
# VT_API_KEY=
VT_UPLOAD=0

MAX_UPLOAD_MB=200
MAX_IMAGE_MB=5
HOLD_MINUTES=60
TRUST_PROXY=0

# TMNF/TMUF server list at GET /tmf/servers: on only with BOTH set (contacts the Nadeo master server
# with a bot account; see docs/tmf-master/risks.md). Bot settings: packages/tmf-master/.env.example.
TMF_ENABLED=0
TMF_LIVE=0

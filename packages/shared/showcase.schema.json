{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cheatoskar/tm-horizon/main/packages/shared/showcase.schema.json",
  "title": "TM Horizon mod showcase",
  "description": "A showcase page for a mod: ordered blocks, no HTML, no scripts. Put it in showcase.json in the repository root (or under the \"showcase\" key of plugin.json). The hub validator (packages/shared/src/showcase.ts) is the authority; this schema is for editor hints.",
  "type": "object",
  "additionalProperties": false,
  "required": ["blocks"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "icon": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://.+\\.(png|webp)$",
      "description": "Project icon: square PNG or WebP, at most 512 KB, on raw.githubusercontent.com or a GitHub release. Without it the hub looks for docs/logo/logo-256.png or logo-512.png in the repository."
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accent"],
      "properties": { "accent": { "enum": ["blue", "cyan", "green", "lime", "amber", "orange", "red", "pink", "violet", "slate"] } }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/hero" }, { "$ref": "#/$defs/features" }, { "$ref": "#/$defs/gallery" }, { "$ref": "#/$defs/compare" },
          { "$ref": "#/$defs/video" }, { "$ref": "#/$defs/text" }, { "$ref": "#/$defs/compat" }, { "$ref": "#/$defs/hotkeys" },
          { "$ref": "#/$defs/changelog" }, { "$ref": "#/$defs/faq" }, { "$ref": "#/$defs/cta" }
        ]
      }
    }
  },
  "$defs": {
    "title": { "type": "string", "minLength": 1, "maxLength": 60 },
    "imageUrl": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^(https://(raw\\.githubusercontent\\.com/|i\\.imgur\\.com/|github\\.com/[^/]+/[^/]+/releases/download/|[^/]+/).*|[A-Za-z0-9_./ -]+)\\.(png|jpe?g|webp|gif)$",
      "description": "https, .png/.jpg/.webp/.gif, on raw.githubusercontent.com, i.imgur.com, a GitHub release asset or the hub's own storage. In showcase.json a path in the repository (docs/images/a.png) is also fine; the hub turns it into a raw.githubusercontent.com URL."
    },
    "videoUrl": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^https://((www\\.|m\\.)?youtube\\.com/|youtu\\.be/|(www\\.)?youtube-nocookie\\.com/|(www\\.)?vimeo\\.com/|player\\.vimeo\\.com/|(www\\.)?streamable\\.com/)"
    },
    "httpsUrl": { "type": "string", "maxLength": 500, "pattern": "^https://" },
    "hero": {
      "type": "object", "additionalProperties": false, "required": ["type", "title"],
      "properties": {
        "type": { "const": "hero" },
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "tagline": { "type": "string", "maxLength": 140 },
        "image": { "$ref": "#/$defs/imageUrl" },
        "video": { "$ref": "#/$defs/videoUrl" },
        "badges": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 24 } }
      }
    },
    "features": {
      "type": "object", "additionalProperties": false, "required": ["type", "items"],
      "properties": {
        "type": { "const": "features" },
        "title": { "$ref": "#/$defs/title" },
        "items": {
          "type": "array", "minItems": 1, "maxItems": 9,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["icon", "title", "text"],
            "properties": {
              "icon": { "enum": [
                "sparkles", "sun", "moon", "palette", "zap", "gauge", "keyboard", "mouse-pointer", "monitor", "camera", "film", "image", "wand-2",
                "settings", "sliders-horizontal", "download", "upload", "save", "shield", "lock", "heart", "star", "flag", "trophy", "timer", "clock",
                "map", "route", "car", "wrench", "package", "layers", "cpu", "gamepad-2", "headphones", "volume-2", "music", "globe", "users",
                "message-circle", "book-open", "code-2", "bug", "rocket", "eye", "flame", "droplets", "wind", "cloud", "mountain", "lightbulb",
                "refresh-cw", "check", "languages", "share-2", "puzzle", "gift", "tag", "target"
              ] },
              "title": { "type": "string", "minLength": 1, "maxLength": 40 },
              "text": { "type": "string", "minLength": 1, "maxLength": 140 }
            }
          }
        }
      }
    },
    "gallery": {
      "type": "object", "additionalProperties": false, "required": ["type", "images"],
      "properties": {
        "type": { "const": "gallery" },
        "title": { "$ref": "#/$defs/title" },
        "images": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["url"],
            "properties": { "url": { "$ref": "#/$defs/imageUrl" }, "caption": { "type": "string", "maxLength": 120 }, "alt": { "type": "string", "maxLength": 120 } }
          }
        }
      }
    },
    "compare": {
      "type": "object", "additionalProperties": false, "required": ["type", "before", "after"],
      "properties": {
        "type": { "const": "compare" },
        "title": { "$ref": "#/$defs/title" },
        "before": { "type": "object", "additionalProperties": false, "required": ["url"], "properties": { "url": { "$ref": "#/$defs/imageUrl" }, "label": { "type": "string", "maxLength": 24 } } },
        "after": { "type": "object", "additionalProperties": false, "required": ["url"], "properties": { "url": { "$ref": "#/$defs/imageUrl" }, "label": { "type": "string", "maxLength": 24 } } },
        "caption": { "type": "string", "maxLength": 120 }
      }
    },
    "video": {
      "type": "object", "additionalProperties": false, "required": ["type", "url"],
      "properties": {
        "type": { "const": "video" },
        "title": { "$ref": "#/$defs/title" },
        "url": { "$ref": "#/$defs/videoUrl" },
        "caption": { "type": "string", "maxLength": 120 },
        "poster": { "$ref": "#/$defs/imageUrl" }
      }
    },
    "text": {
      "type": "object", "additionalProperties": false, "required": ["type", "markdown"],
      "properties": {
        "type": { "const": "text" },
        "title": { "$ref": "#/$defs/title" },
        "markdown": { "type": "string", "minLength": 1, "maxLength": 4000, "description": "Headings (# to ####), lists, **bold**, *italic*, `code`, code fences and [links](https://...). Everything else stays plain text." }
      }
    },
    "compat": {
      "type": "object", "additionalProperties": false, "required": ["type", "rows"],
      "properties": {
        "type": { "const": "compat" },
        "title": { "$ref": "#/$defs/title" },
        "rows": {
          "type": "array", "minItems": 1, "maxItems": 14,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["game", "status"],
            "properties": {
              "game": { "enum": ["tmnf", "tmuf", "eswc", "tm2-canyon", "tm2-stadium", "tm2-valley", "tm2-lagoon", "sm-storm", "tm2020", "turbo", "tmo", "tms"] },
              "status": { "enum": ["works", "partial", "planned", "no"] },
              "note": { "type": "string", "maxLength": 80 }
            }
          }
        }
      }
    },
    "hotkeys": {
      "type": "object", "additionalProperties": false, "required": ["type", "rows"],
      "properties": {
        "type": { "const": "hotkeys" },
        "title": { "$ref": "#/$defs/title" },
        "rows": {
          "type": "array", "minItems": 1, "maxItems": 20,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["keys", "action"],
            "properties": { "keys": { "type": "string", "minLength": 1, "maxLength": 24 }, "action": { "type": "string", "minLength": 1, "maxLength": 80 } }
          }
        }
      }
    },
    "changelog": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": { "type": { "const": "changelog" }, "title": { "$ref": "#/$defs/title" }, "count": { "type": "integer", "minimum": 1, "maximum": 3 } }
    },
    "faq": {
      "type": "object", "additionalProperties": false, "required": ["type", "items"],
      "properties": {
        "type": { "const": "faq" },
        "title": { "$ref": "#/$defs/title" },
        "items": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["q", "a"],
            "properties": { "q": { "type": "string", "minLength": 1, "maxLength": 120 }, "a": { "type": "string", "minLength": 1, "maxLength": 600 } }
          }
        }
      }
    },
    "cta": {
      "type": "object", "additionalProperties": false, "required": ["type", "buttons"],
      "properties": {
        "type": { "const": "cta" },
        "title": { "$ref": "#/$defs/title" },
        "text": { "type": "string", "maxLength": 160 },
        "buttons": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["kind", "label"],
            "properties": {
              "kind": { "enum": ["install", "companion", "link"] },
              "label": { "type": "string", "minLength": 1, "maxLength": 30 },
              "url": { "$ref": "#/$defs/httpsUrl" },
              "style": { "enum": ["primary", "ghost"] }
            }
          }
        }
      }
    }
  }
}

  },
  "servers": {
    "maniaplanet": {
      "enabled": true,
      "pages": 1,
      "pageSize": 100,
      "minPlayers": 0,
      "ttlMinutes": 10
    },
    "trackmaniaIo": {
      "enabled": true,
      "pages": 1,
      "ttlMinutes": 10
    },
    "community": {
      "comment": "Registered servers in data/servers/*.yaml; each build tries a TCP connect to the game port.",
      "enabled": true,
      "dir": "data/servers",
      "timeoutMs": 3000,
      "concurrency": 16
    },
    "eswcMaster": {
      "comment": "TM Nations ESWC getservers.php (no login, TLS 1.0). Live-tested 2026-11-10: one master server (docs/eswc-masterserver.md).",
      "enabled": true,
      "host": "game.trackmanianations.com",
      "path": "/online_game",
      "version": "0.1.7.9",
      "lang": "en",
      "timeoutMs": 10000,
      "certSha256": "BF:86:09:07:AA:5F:E4:00:15:AA:11:CA:5B:19:69:CD:F8:87:E3:E5:B9:74:EF:F0:AE:B2:E9:61:FC:F6:9E:3A"
    }
  },
  "events": {
    "comment": "Approved event submissions (issue form event.yml) in data/events/*.yaml; past events drop out.",
    "submittedDir": "data/events",
    "live": {
      "comment": "Public event sources without a secret: trackmania.io competitions (the newest `lookup` are checked for dates) and the TMTAS exchange events page (TAS events).",
      "trackmaniaIo": {
        "enabled": true,
        "lookup": 12,
        "ttlMinutes": 30
      },
      "tmtas": {
        "enabled": true,
        "ttlMinutes": 30
      }
    }
  },
  "communities": {
    "comment": "Discord server list kept by mx_eyebo (Mania Exchange) as a public Google Sheet; the xlsx export keeps the hyperlinks. Each invite is looked up once per inviteTtlHours with GET discord.com/api/v10/invites/<code>?with_counts=true, sequential, delayMs apart, at most maxLookupsPerBuild per build (oldest first). Ask mx_eyebo before this goes public.",
    "enabled": true,
    "sheetUrl": "https://docs.google.com/spreadsheets/d/1Rr581P5Icd5_-bYypVLaUDqi1pdMGbBNM-E7Bapz_ME/",
    "exportUrl": "https://docs.google.com/spreadsheets/d/1Rr581P5Icd5_-bYypVLaUDqi1pdMGbBNM-E7Bapz_ME/export?format=xlsx",
    "sheetTtlHours": 24,
    "inviteTtlHours": 24,
    "delayMs": 1100,
    "maxLookupsPerBuild": 150
  },
  "catalog": {
    "comment": "First readable path wins (packages/catalog in this monorepo), then url.",
    "paths": [
      "../catalog/catalog.json"
    ],
    "url": null

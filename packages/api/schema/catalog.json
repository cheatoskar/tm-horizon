{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/CatalogFile",
  "definitions": {
    "CatalogFile": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1,
          "description": "Format version of this file; bumped on breaking changes."
        },
        "generated": {
          "$ref": "#/definitions/IsoDateTime"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceStatus"
          }
        },
        "collections": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CatalogCollection"
          },
          "description": "Curated collections (Graphics, QoL, TAS, ...)."
        },
        "pictures": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CatalogPictures"
          },
          "description": "Picture overrides (mods whose homepage shows another project)."
        },
        "catalogUpdated": {
          "type": [
            "string",
            "null"
          ],
          "description": "\"updated\" field of the source catalog."
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CatalogEntry"
          }
        }
      },
      "required": [
        "catalogUpdated",
        "entries",
        "generated",
        "schemaVersion",
        "sources"
      ],
      "additionalProperties": false
    },
    "IsoDateTime": {
      "type": "string",
      "description": "ISO 8601 date-time in UTC, e.g. \"2026-11-10T16:00:00.000Z\"."
    },
    "SourceStatus": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Source id, e.g. \"modloader:https://unlimiter.net/modloader/\" or \"tmx:tmnf\"."
        },
        "ok": {
          "type": "boolean"
        },
        "count": {
          "type": "number",
          "description": "Items this source contributed."
        },
        "sample": {
          "type": "boolean",
          "description": "true when the items are made-up sample data (no token, no public source)."
        },
        "cached": {
          "type": "boolean",
          "description": "Served from the local cache instead of the network (fresh enough or the network failed)."
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "ok",
        "count",
        "sample"
      ],
      "additionalProperties": false,
      "description": "How one source did during the build."
    },
    "CatalogCollection": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Catalog entry ids and TMLoader product ids."
        }
      },
      "required": [
        "id",
        "name",
        "entries"
      ],
      "additionalProperties": false,
      "description": "A hand-picked group of mods shown as a chip at the top of the launcher's Mods page."
    },
    "CatalogPictures": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string",
          "description": "TMLoader product name or catalog id."
        },
        "repo": {
          "type": [
            "string",
            "null"
          ],
          "description": "GitHub repository for README and pictures; null = none (do not use the homepage)."
        },
        "banner": {
          "type": "string"
        },
        "gallery": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "mod"
      ],
      "additionalProperties": false,
      "description": "Picture override for a mod whose homepage is another project's repository."
    },
    "CatalogEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "$ref": "#/definitions/CatalogCategory"
        },
        "games": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CatalogGameId"
          }
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "description": "null: the file only exists as a Discord attachment (hosting \"discord-attachment\") or not known yet (hosting \"pending\")."
        },
        "api": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "maintainer": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "alive",
            "dead",
            "unclear"
          ]
        },
        "checked": {
          "type": [
            "string",
            "null"
          ]
        },
        "launcher": {
          "type": [
            "string",
            "null"
          ],
          "description": "What the launcher can do with it."
        },
        "archive": {
          "type": [
            "string",
            "null"
          ]
        },
        "github": {
          "type": [
            "string",
            "null"
          ],
          "description": "\"owner/repo\" when url or api is a GitHub repository (see projects.json)."
        },
        "author": {
          "type": [
            "string",
            "null"
          ],
          "description": "Mods from the community Discord's mod channel and a few others: author as posted."
        },
        "modType": {
          "type": [
            "string",
            "null"
          ],
          "description": "interface, sound, block, skin, texturepack, blockskin, standalone, fix, music, vehicle, medals, utility, graphics, hud."
        },
        "install": {
          "type": [
            "string",
            "null"
          ],
          "description": "How it is installed: \"tmloader\", \"gamedata: <target path>\", \"skins\", \"unlimiter-required\", \"manual\", or a sentence."
        },
        "installs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Per game how it gets installed: 'tmloader' or 'proxy:<dll>' (a DLL next to the game's exe, e.g. proxy:d3d11.dll)."
        },
        "installSpec": {
          "anyOf": [
            {
              "$ref": "#/definitions/InstallSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the launcher can install itself; null: not installable (see downloadNote)."
        },
        "downloadNote": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why there is no installSpec (\"download only via the Discord post\", ...)."
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Other mods or tools it needs."
        },
        "hosting": {
          "type": [
            "string",
            "null"
          ],
          "description": "github, own-site, maniapark, archive.org, google-drive, yandex, discord-attachment."
        },
        "urls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Mirrors and companion links."
        },
        "gallery": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Picture URLs (https) shown as a gallery."
        },
        "banner": {
          "type": "string",
          "description": "A hand-picked first picture (card banner and mod-page hero), overrides the automatic choice."
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "games",
        "url",
        "api",
        "description",
        "maintainer",
        "language",
        "status",
        "checked",
        "launcher",
        "archive",
        "github"
      ],
      "additionalProperties": false
    },
    "CatalogCategory": {
      "type": "string",
      "enum": [
        "exchange",
        "mod",
        "tool",
        "skins",
        "leaderboard",
        "tas-plugin",
        "servers",
        "community",
        "docs",
        "environment",
        "events"
      ]
    },
    "CatalogGameId": {
      "anyOf": [
        {
          "$ref": "#/definitions/GameId"
        },
        {
          "type": "string",
          "const": "tm1"
        },
        {
          "type": "string",
          "const": "tmsx"
        },
        {
          "type": "string",
          "const": "tmu2006"
        }
      ],
      "description": "Extra game ids only catalog entries use: TrackMania (2003, \"TM 1.0\"), Sunrise eXtreme, United (2006)."
    },
    "GameId": {
      "type": "string",
      "enum": [
        "tmo",
        "tms",
        "eswc",
        "tmnf",
        "tmuf",
        "tm2-canyon",
        "tm2-stadium",
        "tm2-valley",
        "tm2-lagoon",
        "sm-storm",
        "tm2020",
        "turbo"
      ],
      "description": "Game ids shared with the catalog (packages/catalog/catalog.json)."
    },
    "InstallSpec": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "files",
            "tmloader-product"
          ],
          "description": "files: copy files to a base folder; tmloader-product: the zip holds <Product>/<version>/ with description.yaml."
        },
        "download": {
          "type": "object",
          "properties": {
            "github": {
              "type": "string",
              "description": "\"owner/repo\": the latest release's asset."
            },
            "asset": {
              "type": "string",
              "description": "Case-insensitive glob (\"*\" only) for the asset name; default the first .zip, then .dll."
            },
            "url": {
              "type": "string",
              "description": "https direct link (Google Drive usercontent link or a Yandex Disk public link are fine)."
            }
          },
          "additionalProperties": false
        },
        "base": {
          "type": "string",
          "enum": [
            "game",
            "gamedata",
            "documents",
            "tmi-plugins",
            "tmi-scripts"
          ],
          "description": "game = next to the game exe, gamedata = <game>\\GameData, documents = Documents\\TrackMania, tmi-plugins / tmi-scripts = Documents\\TMInterface\\Plugins / \\Scripts (tmnf, tmuf)."
        },
        "strip": {
          "type": "number",
          "description": "Leading folders inside the zip to drop."
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Path prefixes (after strip) to copy; default all files."
        },
        "games": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Launcher game ids it installs into."
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string",
          "description": "Short reason or limit shown in the UI."
        },
        "sha256": {
          "type": "string",
          "description": "Known SHA-256 of the download; the installer refuses another file (hub copies always set it)."
        },
        "version": {
          "type": "string",
          "description": "Version of the download when the source knows it (hub copies); recorded instead of \"latest\"."
        }
      },
      "required": [
        "kind",
        "download",
        "games"
      ],
      "additionalProperties": false,
      "description": "How the launcher installs a catalog mod's file (verified against the real download)."
    }
  },
  "$id": "https://cheatoskar.github.io/tm-hub/schema/catalog.json",
  "title": "tm-hub catalog.json"
}

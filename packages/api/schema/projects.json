{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ProjectsFile",
  "definitions": {
    "ProjectsFile": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1,
          "description": "Format version of this file; bumped on breaking changes."
        },
        "generated": {
          "$ref": "#/definitions/IsoDateTime"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceStatus"
          }
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Project"
          }
        }
      },
      "required": [
        "generated",
        "projects",
        "schemaVersion",
        "sources"
      ],
      "additionalProperties": false
    },
    "IsoDateTime": {
      "type": "string",
      "description": "ISO 8601 date-time in UTC, e.g. \"2026-11-10T16:00:00.000Z\"."
    },
    "SourceStatus": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Source id, e.g. \"modloader:https://unlimiter.net/modloader/\" or \"tmx:tmnf\"."
        },
        "ok": {
          "type": "boolean"
        },
        "count": {
          "type": "number",
          "description": "Items this source contributed."
        },
        "sample": {
          "type": "boolean",
          "description": "true when the items are made-up sample data (no token, no public source)."
        },
        "cached": {
          "type": "boolean",
          "description": "Served from the local cache instead of the network (fresh enough or the network failed)."
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "ok",
        "count",
        "sample"
      ],
      "additionalProperties": false,
      "description": "How one source did during the build."
    },
    "Project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "\"owner/repo\" as GitHub spells it."
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": "string"
        },
        "homepage": {
          "type": [
            "string",
            "null"
          ]
        },
        "stars": {
          "type": "number"
        },
        "forks": {
          "type": "number"
        },
        "openIssues": {
          "type": "number"
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "archived": {
          "type": "boolean"
        },
        "pushed": {
          "anyOf": [
            {
              "$ref": "#/definitions/IsoDateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProjectRelease"
            },
            {
              "type": "null"
            }
          ],
          "description": "Newest non-draft release (prereleases count when there is no stable one)."
        },
        "catalogIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Catalog entry ids pointing at this repository."
        },
        "games": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GameId"
          }
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "url",
        "homepage",
        "stars",
        "forks",
        "openIssues",
        "language",
        "license",
        "topics",
        "archived",
        "pushed",
        "release",
        "catalogIds",
        "games"
      ],
      "additionalProperties": false
    },
    "ProjectRelease": {
      "type": "object",
      "properties": {
        "tag": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "published": {
          "anyOf": [
            {
              "$ref": "#/definitions/IsoDateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "prerelease": {
          "type": "boolean"
        },
        "url": {
          "type": "string"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "description": "Release notes (Markdown), shortened to a few thousand characters."
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReleaseAsset"
          }
        }
      },
      "required": [
        "tag",
        "name",
        "published",
        "prerelease",
        "url",
        "notes",
        "assets"
      ],
      "additionalProperties": false
    },
    "ReleaseAsset": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "size": {
          "type": "number"
        },
        "download": {
          "type": "string"
        },
        "downloads": {
          "type": "number"
        },
        "contentType": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "size",
        "download",
        "downloads",
        "contentType"
      ],
      "additionalProperties": false
    },
    "GameId": {
      "type": "string",
      "enum": [
        "tmo",
        "tms",
        "eswc",
        "tmnf",
        "tmuf",
        "tm2-canyon",
        "tm2-stadium",
        "tm2-valley",
        "tm2-lagoon",
        "sm-storm",
        "tm2020",
        "turbo"
      ],
      "description": "Game ids shared with the catalog (packages/catalog/catalog.json)."
    }
  },
  "$id": "https://cheatoskar.github.io/tm-hub/schema/projects.json",
  "title": "tm-hub projects.json"
}

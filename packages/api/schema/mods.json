{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ModsFile",
  "definitions": {
    "ModsFile": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1,
          "description": "Format version of this file; bumped on breaking changes."
        },
        "generated": {
          "$ref": "#/definitions/IsoDateTime"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceStatus"
          }
        },
        "mods": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Mod"
          }
        }
      },
      "required": [
        "generated",
        "mods",
        "schemaVersion",
        "sources"
      ],
      "additionalProperties": false
    },
    "IsoDateTime": {
      "type": "string",
      "description": "ISO 8601 date-time in UTC, e.g. \"2026-11-10T16:00:00.000Z\"."
    },
    "SourceStatus": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Source id, e.g. \"modloader:https://unlimiter.net/modloader/\" or \"tmx:tmnf\"."
        },
        "ok": {
          "type": "boolean"
        },
        "count": {
          "type": "number",
          "description": "Items this source contributed."
        },
        "sample": {
          "type": "boolean",
          "description": "true when the items are made-up sample data (no token, no public source)."
        },
        "cached": {
          "type": "boolean",
          "description": "Served from the local cache instead of the network (fresh enough or the network failed)."
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "ok",
        "count",
        "sample"
      ],
      "additionalProperties": false,
      "description": "How one source did during the build."
    },
    "Mod": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "TMLoader product id (the key in the index; dependencies refer to it)."
        },
        "slug": {
          "type": "string",
          "description": "URL-safe form of id, e.g. \"tm-vibrant-shaders\"."
        },
        "name": {
          "type": "string"
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "homepage": {
          "type": [
            "string",
            "null"
          ]
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ],
          "description": "\"modification\" or \"program\" (the patched game itself)."
        },
        "external": {
          "type": "boolean",
          "description": "TMLoader marks the game program as external."
        },
        "games": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GameId"
          }
        },
        "category": {
          "$ref": "#/definitions/ModCategory"
        },
        "loaderGame": {
          "type": "string",
          "description": "TMLoader game the index belongs to, e.g. \"TmForever\"."
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Repository URLs that list this mod (TMLoader \"servers\")."
        },
        "versions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ModVersion"
          },
          "description": "Newest version first."
        },
        "latest": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "author",
        "description",
        "homepage",
        "icon",
        "type",
        "external",
        "games",
        "category",
        "loaderGame",
        "repositories",
        "versions",
        "latest"
      ],
      "additionalProperties": false
    },
    "GameId": {
      "type": "string",
      "enum": [
        "tmo",
        "tms",
        "eswc",
        "tmnf",
        "tmuf",
        "tm2-canyon",
        "tm2-stadium",
        "tm2-valley",
        "tm2-lagoon",
        "sm-storm",
        "tm2020",
        "turbo"
      ],
      "description": "Game ids shared with the catalog (packages/catalog/catalog.json)."
    },
    "ModCategory": {
      "type": "string",
      "enum": [
        "graphics",
        "HUD",
        "tools",
        "TAS",
        "editor",
        "competition",
        "VR",
        "library"
      ]
    },
    "ModVersion": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "executable": {
          "type": [
            "string",
            "null"
          ],
          "description": "DLL or EXE TMLoader loads, e.g. \"TMVibrantShaders.dll\"."
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ModDependency"
          }
        },
        "changelog": {
          "type": [
            "string",
            "null"
          ]
        },
        "download": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256Index": {
          "type": [
            "string",
            "null"
          ],
          "description": "SHA-256 the repository index states."
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "description": "SHA-256 computed by downloading the file (only the newest version is downloaded)."
        },
        "size": {
          "type": [
            "number",
            "null"
          ],
          "description": "Bytes, from the download."
        },
        "hashMismatch": {
          "type": "boolean",
          "description": "sha256 and sha256Index both known and different."
        },
        "priority": {
          "type": "number",
          "description": "TMLoader load priority, if the index sets one."
        }
      },
      "required": [
        "version",
        "executable",
        "dependencies",
        "changelog",
        "download",
        "sha256Index",
        "sha256",
        "size"
      ],
      "additionalProperties": false
    },
    "ModDependency": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "TMLoader product id, e.g. \"CoreMod\"."
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "description": "Semver range as in the index, e.g. \"^1.0.1\"; null = any."
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    }
  },
  "$id": "https://cheatoskar.github.io/tm-hub/schema/mods.json",
  "title": "tm-hub mods.json"
}

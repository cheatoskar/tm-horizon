{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/MapsFile",
  "definitions": {
    "MapsFile": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1,
          "description": "Format version of this file; bumped on breaking changes."
        },
        "generated": {
          "$ref": "#/definitions/IsoDateTime"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceStatus"
          }
        },
        "lists": {
          "type": "object",
          "properties": {
            "awarded": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            }
          },
          "required": [
            "awarded",
            "latest"
          ],
          "additionalProperties": false,
          "description": "The order of each list per site."
        },
        "maps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MapEntry"
          }
        }
      },
      "required": [
        "generated",
        "lists",
        "maps",
        "schemaVersion",
        "sources"
      ],
      "additionalProperties": false
    },
    "IsoDateTime": {
      "type": "string",
      "description": "ISO 8601 date-time in UTC, e.g. \"2026-11-10T16:00:00.000Z\"."
    },
    "SourceStatus": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Source id, e.g. \"modloader:https://unlimiter.net/modloader/\" or \"tmx:tmnf\"."
        },
        "ok": {
          "type": "boolean"
        },
        "count": {
          "type": "number",
          "description": "Items this source contributed."
        },
        "sample": {
          "type": "boolean",
          "description": "true when the items are made-up sample data (no token, no public source)."
        },
        "cached": {
          "type": "boolean",
          "description": "Served from the local cache instead of the network (fresh enough or the network failed)."
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "ok",
        "count",
        "sample"
      ],
      "additionalProperties": false,
      "description": "How one source did during the build."
    },
    "MapEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "\"<site>:<id>\", e.g. \"tmnf-x:3726386\"."
        },
        "site": {
          "type": "string"
        },
        "game": {
          "$ref": "#/definitions/GameId"
        },
        "lists": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MapList"
          },
          "description": "Lists the map is in (a map can be both recently awarded and new)."
        },
        "exchangeId": {
          "type": "number",
          "description": "Exchange id of the map/track."
        },
        "name": {
          "type": "string",
          "description": "Name without $-formatting codes."
        },
        "nameRaw": {
          "type": "string",
          "description": "Name as stored, may contain $-formatting codes."
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "awards": {
          "type": "number"
        },
        "uploaded": {
          "anyOf": [
            {
              "$ref": "#/definitions/IsoDateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "environment": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": "string",
          "description": "Map page on the exchange."
        },
        "thumbnail": {
          "type": [
            "string",
            "null"
          ]
        },
        "download": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "site",
        "game",
        "lists",
        "exchangeId",
        "name",
        "nameRaw",
        "author",
        "awards",
        "uploaded",
        "environment",
        "url",
        "thumbnail",
        "download"
      ],
      "additionalProperties": false
    },
    "GameId": {
      "type": "string",
      "enum": [
        "tmo",
        "tms",
        "eswc",
        "tmnf",
        "tmuf",
        "tm2-canyon",
        "tm2-stadium",
        "tm2-valley",
        "tm2-lagoon",
        "sm-storm",
        "tm2020",
        "turbo"
      ],
      "description": "Game ids shared with the catalog (packages/catalog/catalog.json)."
    },
    "MapList": {
      "type": "string",
      "enum": [
        "awarded",
        "latest"
      ],
      "description": "Which list a map came from."
    }
  },
  "$id": "https://cheatoskar.github.io/tm-hub/schema/maps.json",
  "title": "tm-hub maps.json"
}

# packages/tmf-master: copy to .env (never commit .env). All keys are optional; the defaults are safe:
# without TMF_ENABLED=1 and TMF_LIVE=1 nothing is ever sent to the master server.

# Service on/off. 0 = /tmf/servers answers 503 "disabled".
TMF_ENABLED=0
# Live requests to Nadeo's master server. Only after the owner decided (docs/tmf-master/risks.md).
TMF_LIVE=0

# Dedicated bot account (not your own account). Password stays in this process (key derivation only).
TMF_BOT_LOGIN=
TMF_BOT_PASSWORD=

# Games to poll and how often (seconds, 60..3600) / at most this many requests per minute in total.
TMF_GAMES=tmnf,tmuf
TMF_POLL_SECONDS=90
TMF_MAX_REQ_PER_MIN=6
TMF_PAGE_SIZE=100
TMF_MAX_SERVERS=1000

# Protocol details (defaults from TmForever.exe 2.11.26; change after the capture if needed).
TMF_HOST_TMNF=nations.trackmaniaforever.com
TMF_HOST_TMUF=united.trackmaniaforever.com
TMF_PATH=/online_game
TMF_PORT=80
TMF_VERSION=2.11.26
TMF_DISTRO_TMNF=APIJU
TMF_DISTRO_TMUF=ASPUR
TMF_LANG=en
TMF_PACKMASK_TMNF=40
TMF_PACKMASK_TMUF=7f
TMF_TMUF_PAYING=1
TMF_USER_AGENT=GameBox
# SearchNew params to add or override, JSON object, e.g. {"r":"0.0000"}
TMF_LIST_PARAMS_JSON=
# none = OpenSession only; tmfnet = also Connect after TMF.NET (needs TMF_RSA_PRIVATE_KEY_FILE, see risks.md)
TMF_CONNECT_MODE=none
TMF_RSA_PRIVATE_KEY_FILE=
# random-prefixed (TMF.NET, known to work) or zero
TMF_AUTH_IV=random-prefixed
TMF_TIMEOUT_MS=15000

# scripts/serve.ts only
TMF_HTTP_PORT=8787

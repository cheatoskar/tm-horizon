{
  "$schema": "../../shared/showcase.schema.json",
  "version": 1,
  "theme": {
    "accent": "cyan"
  },
  "blocks": [
    {
      "type": "hero",
      "title": "Nations Converter",
      "tagline": "Converts maps from TrackMania Nations and United Forever to Trackmania (2020).",
      "image": "https://raw.githubusercontent.com/BigBang1112/nations-converter/HEAD/Src/NationsConverterWeb/NationsConverterWeb/wwwroot/img/comparisons/StadiumCrystalClassic_after.jpg",

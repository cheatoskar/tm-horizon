        "TMNF, TMUF to TM2020",
        "Web tool",
        "Open source"
      ]
    },
    {
      "type": "features",
      "items": [
        {
          "icon": "refresh-cw",
          "title": "Map conversion",
          "text": "Turns old Nations and United maps into maps for Trackmania (2020)."
        },
        {
          "icon": "music",
          "title": "Music",
          "text": "Adds music to non-Stadium maps by default; the option can be switched off or pointed at other tracks."
        },
        {
          "icon": "layers",
          "title": "Environments",
          "text": "Examples in the repository cover Stadium, Snow, Rally and Desert maps."
        },
        {
          "icon": "code-2",
          "title": "Open source",
          "text": "Licensed AGPL-3.0; the source is on GitHub."
        }
      ]
    },
    {
      "type": "compare",
      "before": {
        "url": "https://raw.githubusercontent.com/BigBang1112/nations-converter/HEAD/Src/NationsConverterWeb/NationsConverterWeb/wwwroot/img/comparisons/RallySolidModless_before.jpg",
